<UserControl
    x:Class="IcdMapper_Excel.Views.IcdMapperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IcdMapper_Excel.Views"
    mc:Ignorable="d"
    xmlns:vm="clr-namespace:IcdMapper_Excel.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:IcdMapperViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <Style
            TargetType="Button">
            <Setter
                Property="Padding"
                Value="12,5" />
            <Setter
                Property="Margin"
                Value="4,0" />
            <Setter
                Property="MinWidth"
                Value="90" />
        </Style>
        <Style
            TargetType="Label">
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
        </Style>
        <Style
            TargetType="TextBox">
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="Padding"
                Value="4,3" />
        </Style>
    </UserControl.Resources>
    <Grid
        Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <!-- 파일 선택 -->
            <RowDefinition
                Height="Auto" />
            <!-- 행 설정 -->
            <RowDefinition
                Height="Auto" />
            <!-- 프로파일 -->
            <RowDefinition
                Height="*" />
            <!-- 매핑 + 미리보기 -->
            <RowDefinition
                Height="Auto" />
            <!-- 액션 버튼 -->
            <RowDefinition
                Height="Auto" />
            <!-- 상태바 -->
        </Grid.RowDefinitions>

        <!-- ① 파일 선택 -->
        <GroupBox
            Grid.Row="0"
            Header="엑셀 파일"
            Margin="0,0,0,8"
            Padding="8">
            <DockPanel>
                <Button
                    DockPanel.Dock="Right"
                    Content="찾아보기"
                    Command="{Binding BrowseExcelCommand}" />
                <Label
                    DockPanel.Dock="Right"
                    Content="시트:"
                    Margin="16,0,4,0" />
                <ComboBox
                    DockPanel.Dock="Right"
                    Width="160"
                    ItemsSource="{Binding SheetNames}"
                    SelectedItem="{Binding SelectedSheetName, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{Binding HasSheets}" />
                <TextBox
                    IsReadOnly="True"
                    Text="{Binding ExcelPath, Mode=OneWay}"
                    Background="#F5F5F5" />
            </DockPanel>
        </GroupBox>

        <!-- ② 행 설정 -->
        <GroupBox
            Grid.Row="1"
            Header="행 설정 (0-based)"
            Margin="0,0,0,8"
            Padding="8">
            <StackPanel
                Orientation="Horizontal">
                <Label
                    Content="헤더 행:" />
                <TextBox
                    Width="60"
                    Text="{Binding HeaderRowIndex, UpdateSourceTrigger=PropertyChanged}" />
                <Label
                    Content="데이터 시작 행:"
                    Margin="16,0,0,0" />
                <TextBox
                    Width="60"
                    Text="{Binding DataStartRow, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </GroupBox>

        <!-- ③ 프로파일 -->
        <GroupBox
            Grid.Row="2"
            Header="매핑 프로파일"
            Margin="0,0,0,8"
            Padding="8">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Content="저장"
                        Command="{Binding SaveProfileCommand}" />
                    <Button
                        Content="삭제"
                        Command="{Binding DeleteProfileCommand}" />
                </StackPanel>
                <Label
                    Content="저장된 프로파일:"
                    Width="110" />
                <ComboBox
                    ItemsSource="{Binding SavedProfiles}"
                    SelectedItem="{Binding SelectedProfile}"
                    DisplayMemberPath="ProfileName"
                    Width="200"
                    Margin="0,0,16,0" />
                <Label
                    Content="프로파일 이름:" />
                <TextBox
                    Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                    Width="200" />
            </DockPanel>
        </GroupBox>

        <!-- ④ 매핑 테이블 + JSON 미리보기 -->
        <Grid
            Grid.Row="3"
            Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="8" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 컬럼 매핑 -->
            <GroupBox
                Grid.Column="0"
                Header="컬럼 매핑"
                Padding="4">
                <DataGrid
                    ItemsSource="{Binding ColumnMappings}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="엑셀 헤더"
                            Binding="{Binding ExcelHeader}"
                            Width="*"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            Header="ICD 속성"
                            Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        ItemsSource="{Binding IcdProperties}"
                                        SelectedItem="{Binding SelectedIcdProperty, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch" />

            <!-- JSON 미리보기 -->
            <GroupBox
                Grid.Column="2"
                Header="JSON 미리보기"
                Padding="4">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">
                    <TextBox
                        Text="{Binding JsonPreview, Mode=OneWay}"
                        IsReadOnly="True"
                        FontFamily="Consolas"
                        FontSize="12"
                        Background="#1E1E1E"
                        Foreground="#D4D4D4"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto" />
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- ⑤ 액션 버튼 -->
        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,0,0,8">
            <Button
                Content="변환 미리보기"
                Command="{Binding ConvertCommand}"
                FontWeight="SemiBold" />
            <Button
                Content="JSON 저장"
                Command="{Binding ExportJsonCommand}"
                Background="#0078D7"
                Foreground="White"
                FontWeight="SemiBold" />
        </StackPanel>

        <!-- ⑥ 상태바 -->
        <Border
            Grid.Row="5"
            Background="#F0F0F0"
            BorderBrush="#CCCCCC"
            BorderThickness="0,1,0,0"
            Padding="8,4">
            <TextBlock
                Text="{Binding StatusMessage}"
                Foreground="#444" />
        </Border>
    </Grid>
</UserControl>